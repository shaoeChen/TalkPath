# TalkPath provider configuration
# Copy this file to .env and keep real credentials out of version control.

# Default production path. Set to pi only for experimental Pi RPC mode.
TALKPATH_AGENT_BACKEND=direct

# Provider HTTP timeout in seconds. OpenAI-compatible vision models can take
# 60-120+ seconds per image, so keep this generous (300 is a safe budget).
TALKPATH_PROVIDER_TIMEOUT_SECONDS=300

TALKPATH_VISION_BACKEND=fake
TALKPATH_VISION_BASE_URL=
TALKPATH_VISION_API_KEY=
TALKPATH_VISION_MODEL=default

TALKPATH_TEXT_BACKEND=fake
TALKPATH_TEXT_BASE_URL=
TALKPATH_TEXT_API_KEY=
TALKPATH_TEXT_MODEL=default

TALKPATH_STT_BACKEND=fake
TALKPATH_STT_BASE_URL=
TALKPATH_STT_API_KEY=
TALKPATH_STT_MODEL=default
TALKPATH_STT_PROTOCOL=talkpath
TALKPATH_STT_TRANSCRIBE_PATH=/transcribe

TALKPATH_TTS_BACKEND=fake
TALKPATH_TTS_BASE_URL=
TALKPATH_TTS_MODEL=default

# For an OpenAI-compatible Vision/Text service, set:
# TALKPATH_VISION_BACKEND=openai_compatible
# TALKPATH_VISION_BASE_URL=https://provider.example/v1
# TALKPATH_VISION_API_KEY=replace-locally
# TALKPATH_VISION_MODEL=replace-locally
#
# For local speech HTTP services, set:
# TALKPATH_STT_BACKEND=local_http
# TALKPATH_STT_BASE_URL=http://127.0.0.1:9001
# TALKPATH_TTS_BACKEND=local_http
# TALKPATH_TTS_BASE_URL=http://127.0.0.1:9002
# For Kokoro-FastAPI OpenAI Speech endpoint:
# TALKPATH_TTS_BACKEND=local_http
# TALKPATH_TTS_BASE_URL=http://127.0.0.1:8880
# TALKPATH_TTS_MODEL=kokoro
# TALKPATH_TTS_PROTOCOL=openai_speech
# TALKPATH_TTS_SPEECH_PATH=/v1/audio/speech
# TALKPATH_TTS_VOICE=af_bella
# TALKPATH_TTS_RESPONSE_FORMAT=mp3
# TALKPATH_TTS_SPEED=0.9
#
# 使用 docker/compose.speech.yml 的 qwen3-asr-service（設定固定的私有密鑰）：
# TALKPATH_STT_BACKEND=local_http
# TALKPATH_STT_BASE_URL=http://127.0.0.1:8765
# TALKPATH_STT_API_KEY=replace-with-a-private-fixed-key
# TALKPATH_STT_MODEL=qwen3-asr-0.6b
# TALKPATH_STT_PROTOCOL=openai_transcription
# TALKPATH_STT_TRANSCRIBE_PATH=/compat/openai/v1/audio/transcriptions
#
# Enable real smoke tests explicitly:
# TALKPATH_LIVE_TESTS=1
